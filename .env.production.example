###############################################################################
# ABMSignal — production environment template (CONTAINERS: web + migrate)
#
# Copy to `.env.production` on the server and fill in real values:
#     cp .env.production.example .env.production
#     chmod 600 .env.production
#
# NEVER commit .env.production (it is git-ignored). Values prefixed with
# NEXT_PUBLIC_ are ALSO needed at `docker build` time (see docker-compose.yml).
#
# The HOST worker uses a SEPARATE file (.env.worker) for the Redis override —
# see .env.worker.example. Everything else (secrets) is shared from here.
###############################################################################

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
# The APP lives on the app subdomain; the apex (abmsignal.com) is marketing only.
NEXT_PUBLIC_APP_URL=https://app.abmsignal.com

# ── Database: Supabase Postgres (Prisma) ─────────────────────────────────────
# From Supabase → Project Settings → Database → Connection string.
# Runtime uses the TRANSACTION POOLER (port 6543, add ?pgbouncer=true).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations use a DIRECT/session connection (port 5432) — no pgbouncer.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Supabase Auth + client ───────────────────────────────────────────────────
# From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY (admin user creation, privileged ops). Never
# expose to the client. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Auth providers (Google) and email sending (Resend via custom SMTP) are
# configured in the SUPABASE DASHBOARD, not here — see deployment_setup.md.

# ── Redis / job queue ────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-long-random-string
# CONTAINER URL — web reaches redis via the compose service name.
REDIS_URL=redis://:change-me-long-random-string@redis:6379

# ── Payments: Lemon Squeezy (merchant of record) ─────────────────────────────
# Lemon Squeezy dashboard → Settings → API (key) and Webhooks (signing secret).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_GROWTH_VARIANT_ID=
LEMONSQUEEZY_ONE_OFF_VARIANT_ID=

# ── Payments: Stripe (LEGACY — currently mock; safe to leave blank) ──────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── AI engine (OpenClaw — runs on the HOST via the worker) ───────────────────
# The worker execs the local OpenClaw CLI in --local mode. Consumed mainly by
# the HOST worker (.env.worker); repeated here for reference.
OPENCLAW_BIN=/home/trinexis-dgx-spark/.openclaw/bin/openclaw
OPENCLAW_STATE_DIR=/home/trinexis-dgx-spark/.openclaw-abmsignal
OPENCLAW_ABMSIGNAL_URL=http://localhost:18790
OPENCLAW_ABMSIGNAL_TOKEN=
AGENT_TIMEOUT_MS=1800000
