###############################################################################
# ABMSignal — HOST worker overrides
#
# The worker runs on the HOST (not in Docker) because it execs the local
# OpenClaw CLI + Ollama. The systemd unit (infra/abmsignal-worker.service)
# loads BOTH files, in order:
#     1. .env.production   (shared: DATABASE_URL=Supabase, secrets, OpenClaw...)
#     2. .env.worker       (THIS file — host-only overrides)
# Later file wins, so the values below override .env.production.
#
# Copy and fill locally (git-ignored):
#     cp .env.worker.example .env.worker
#     chmod 600 .env.worker
#
# NOTE: DATABASE_URL is the SAME Supabase URL for both the container and the
# host worker, so it is inherited from .env.production — do NOT override it here.
###############################################################################

# Redis is published on loopback by docker-compose; reach it via 127.0.0.1
# (the container uses redis:6379). Use the SAME password as REDIS_PASSWORD.
REDIS_URL=redis://:change-me-long-random-string@127.0.0.1:6379

# Worker parallelism (concurrent playbook jobs). OpenClaw is heavy — keep low.
WORKER_CONCURRENCY=1
