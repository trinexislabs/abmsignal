generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── User profile ─────────────────────────────────────────────────────────────
// Identities live in Supabase Auth (`auth.users`, UUID). This is the public
// profile table: `id` mirrors `auth.users.id`. A Postgres trigger
// (`handle_new_user`) inserts a row here + a free UserSubscription on sign-up.
// No password column — GoTrue owns credentials.

model User {
  id        String   @id // = auth.users.id (UUID as text)
  name      String?
  email     String   @unique
  image     String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playbooks    Playbook[]
  subscription UserSubscription?
  credits      UserCredit[]
  memberships  OrganizationMember[]

  @@map("User")
}

// ── Billing models ────────────────────────────────────────────────────────────

model UserSubscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             String    @default("free") // "free" | "starter" | "growth" | "professional"
  status           String    @default("active") // "active" | "cancelled" | "past_due" | "trialing"
  stripeCustomerId String?
  stripePriceId    String?
  stripeSubId      String?
  currentPeriodEnd DateTime?
  trialEnd         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCredit {
  id         String   @id @default(cuid())
  userId     String
  amount     Int      // positive = purchased/granted, negative = consumed
  reason     String   // "purchased" | "trial_grant" | "consumed" | "refund"
  playbookId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Multi-tenancy scaffold (MVP: 1 user = 1 org; wired up in future seats tiers) ──

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member") // "owner" | "admin" | "member"
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ── Playbook models ───────────────────────────────────────────────────────────

model Playbook {
  id                String    @id
  userId            String?
  productName       String
  productUrl        String?
  productBrief      String    // JSON
  targetCompany     String
  targetUrl         String?
  industry          String
  geography         String
  priorityTier      String    @default("tier1")
  status            String    @default("draft")
  progressPct       Int       @default(0)
  agentStatus       String    @default("[]") // JSON array of AgentStatus
  failedReason      String?
  paymentStatus     String    @default("pending") // "pending" | "paid" — gates content access post-generation
  paidAt            DateTime?
  paymentReference  String?
  completedAt       DateTime?
  openclawSessionId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User?             @relation(fields: [userId], references: [id])
  runs     PlaybookRun[]
  contacts PlaybookContact[]
  sections PlaybookSection[]
  sources  PlaybookSource[]
  events   PlaybookEvent[]
}

model PlaybookRun {
  id                String    @id @default(cuid())
  playbookId        String
  phase             String    // "research" | "writing" | "review"
  status            String    @default("queued") // "queued" | "running" | "succeeded" | "failed" | "cancelled"
  attempt           Int       @default(1)
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  openclawSessionId String?
  processId         Int?
  stdoutPath        String?
  stderrPath        String?
  rawOutput         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  playbook Playbook       @relation(fields: [playbookId], references: [id])
  events   PlaybookEvent[]
}

model PlaybookContact {
  id                     String   @id @default(cuid())
  playbookId             String
  name                   String
  title                  String
  company                String   @default("")
  linkedinUrl            String?
  email                  String?
  rationale              String?
  sourceUrls             String   @default("[]") // JSON
  confidence             String   @default("medium") // "high" | "medium" | "low"
  source                 String   @default("AI Research")
  verificationStatus     String   @default("pending") // "pending" | "confirmed" | "needs_review" | "removed"
  notes                  String?
  personalizationSignals String   @default("[]") // JSON
  directQuotes           String   @default("[]") // JSON
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  playbook Playbook @relation(fields: [playbookId], references: [id])
}

model PlaybookSection {
  id              String   @id @default(cuid())
  playbookId      String
  sectionKey      String   // "executive_summary" | "account_intelligence" | etc.
  title           String
  contentMarkdown String   @default("")
  status          String   @default("pending") // "pending" | "generating" | "complete" | "reviewed"
  orderIndex      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  playbook Playbook        @relation(fields: [playbookId], references: [id])
  sources  PlaybookSource[]
}

model PlaybookSource {
  id                 String    @id @default(cuid())
  playbookId         String
  sectionId          String?
  url                String
  title              String?
  publisher          String?
  retrievedAt        DateTime?
  confidence         String?   // "high" | "medium" | "low"
  note               String?
  claim              String?
  verificationStatus String    @default("unverified") // "verified" | "needs_review" | "unverified"
  createdAt          DateTime  @default(now())

  playbook Playbook         @relation(fields: [playbookId], references: [id])
  section  PlaybookSection? @relation(fields: [sectionId], references: [id])
}

model PlaybookEvent {
  id         String   @id @default(cuid())
  playbookId String
  runId      String?
  type       String
  message    String
  metadata   String   @default("{}") // JSON
  createdAt  DateTime @default(now())

  playbook Playbook     @relation(fields: [playbookId], references: [id])
  run      PlaybookRun? @relation(fields: [runId], references: [id])
}

// ── Payments (Lemon Squeezy — merchant of record) ───────────────────────────
// One row per transaction (checkout/order/subscription). Audit + state model +
// reconciliation source. userId/playbookId are plain references (no FK) so the
// ledger survives user/playbook deletion.
model Payment {
  id              String   @id @default(cuid())
  userId          String?
  playbookId      String?
  // "unlock" (one finished playbook) | "credit" (top-up) | "subscription" (growth)
  purpose         String
  provider        String   @default("lemonsqueezy")
  // checkout_created | payment_pending | payment_succeeded | payment_failed |
  // subscription_active | subscription_past_due | subscription_cancelled |
  // refunded | chargeback_opened | manual_unlock
  status          String   @default("checkout_created")
  amountCents     Int?
  currency        String   @default("USD")
  checkoutId      String?
  orderId         String?
  subscriptionId  String?
  lemonCustomerId String?
  variantId       String?
  rawJson         String? // last related event payload, for debugging
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([subscriptionId])
}

// Every received provider webhook, for idempotency (dedupeKey = sha256 of the
// raw body) and an audit trail.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("lemonsqueezy")
  eventName   String
  dedupeKey   String    @unique
  payload     String
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventName])
}
